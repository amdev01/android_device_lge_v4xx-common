# Allow unprivileged adb shell to verify RTC sysfs after flash (user builds
# cannot adb root).
allow shell rtc_sysfs:dir search;
allow shell rtc_sysfs:file r_file_perms;

# HITL: root/adb shell poke tests for SwIRRC (issue 009/010)
allow shell irrc_device:chr_file rw_file_perms;
allow shell sw_irrc_debugfs:dir r_dir_perms;
allow shell sw_irrc_debugfs:file rw_file_perms;
